    m_Localized: "\u3053\u306E\u30B3\u30DF\u30E5\u30CB\u30C6\u30A3\u30B5\u30FC\u30D0\u30FC\u3067\u306F\u5354\u529B\u30E9\u30A4\u30D6\u3092\u5229\u7528\u3067\u304D\u307E\u305B\u3093\u3002"
