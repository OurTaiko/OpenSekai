    m_Localized: "#WAVEOFFSET {0} \u8868\u793A\u8C31\u9762\u6BD4\u97F3\u9891\u65E9\u5F00\u59CB {1} \u79D2\uFF0C\u504F\u79FB\u4E0D\u80FD\u4E3A\u8D1F\uFF0C\u5DF2\u8BBE\u4E3A 0\u3002"
