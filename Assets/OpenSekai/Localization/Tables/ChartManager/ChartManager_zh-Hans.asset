    m_Localized: "\u4E0A\u4F20\u524D\u8BF7\u5148\u767B\u5F55 OurTaiko \u8D26\u53F7\uFF1A\u53F3\u4E0A\u89D2\u83DC\u5355 \u203A \u6269\u5C55 \u203A \u8D26\u53F7\u3002"
