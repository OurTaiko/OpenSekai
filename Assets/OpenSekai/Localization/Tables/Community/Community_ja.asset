    m_Localized: "\u30A2\u30AB\u30A6\u30F3\u30C8\u30BB\u30F3\u30BF\u30FC\u3092\u958B\u304F\uFF08\u30CB\u30C3\u30AF\u30CD\u30FC\u30E0\u30FB\u30A2\u30A4\u30B3\u30F3\u30FB\u30D1\u30B9\u30EF\u30FC\u30C9\uFF09"
