      m_Items: []
  - m_Id: 284156000
    m_Localized: "\u30EA\u30AF\u30A8\u30B9\u30C8\u306B\u5931\u6557\u3057\u307E\u3057\u305F\uFF08HTTP {0}\uFF09\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 284156001
    m_Localized: "\u30E6\u30FC\u30B6\u30FC\u540D\u307E\u305F\u306F\u30D1\u30B9\u30EF\u30FC\u30C9\u304C\u9055\u3046\u304B\u3001\u30A2\u30AB\u30A6\u30F3\u30C8\u304C\u6709\u52B9\u5316\u3055\u308C\u3066\u3044\u307E\u305B\u3093\u3002"
    m_Metadata:
      m_Items: []
