    m_Metadata:
      m_Items: []
  - m_Id: 279961687
    m_Localized: Invitation declined.
    m_Metadata:
      m_Items: []
  - m_Id: 279961811
    m_Localized: "\u203BUse a stable connection. Loading may take a while depending on your connection."
    m_Metadata:
      m_Items: []
  - m_Id: 279961856
    m_Localized: 'This chart cannot be posted: it differs too little from the chart it is based on.'
    m_Metadata:
      m_Items: []
  - m_Id: 279961860
    m_Localized: Exceeds the maximum combo count ({1}/{0})
    m_Metadata:
      m_Items: []
