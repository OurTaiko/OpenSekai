  m_TableData:
  - m_Id: 275767469
    m_Localized: 'Changing the BPM moves some data outside the audio''s length.

      Delete that data and change the BPM?'
    m_Metadata:
      m_Items: []
  - m_Id: 275767487
    m_Localized: Changes the BPM at the selected timing.
    m_Metadata:
      m_Items: []
  - m_Id: 275767489
    m_Localized: Changes the scroll speed at the selected timing.
    m_Metadata:
      m_Items: []
  - m_Id: 275767491
    m_Localized: Changes the chart's time signature at the selected timing.
    m_Metadata:
      m_Items: []
  - m_Id: 275767619
    m_Localized: "Lyrics: {0}\u3000Music: {1}\u3000Arrangement: {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 275767635
    m_Localized: 'Sets how many grid divisions a bar has.

      Counted in quarter notes.'
    m_Metadata:
      m_Items: []
  - m_Id: 275767636
    m_Localized: Downloading data
    m_Metadata:
      m_Items: []
  - m_Id: 279961674
