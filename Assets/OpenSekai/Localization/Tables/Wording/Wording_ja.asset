      m_Items: []
  - m_Id: 275767349
    m_Localized: "\u5207\u65AD\u884C\u70BA\u3001\u3082\u3057\u304F\u306F\u4E0D\u6B63\u884C\u70BA\u304C\u9023\u7D9A\u3067\u691C\u51FA\u3055\u308C\u305F\u305F\u3081\u3001\n\u30E9\u30F3\u30AF\u30DE\u30C3\u30C1\u6A5F\u80FD\u3092\u4E00\u6642\u5236\u9650\u3055\u305B\u3066\u3044\u305F\u3060\u304D\u307E\u3059\u3002"
