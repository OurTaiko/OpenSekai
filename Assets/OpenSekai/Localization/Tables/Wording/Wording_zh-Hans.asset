  - m_Id: 284155929
    m_Localized: "\u6BCF\u62BD\u53D61\u6B21\u626D\u86CB\uFF0C\u90FD\u53EF\u83B7\u5F97\u5404\u79CD\u9053\u5177\u4F5C\u4E3A\u5956\u54C1\u3002\n\n\u203B\u5956\u54C1\u62BD\u9009\u4F1A\u5728\u626D\u86CB\u7ED3\u679C\u753B\u9762\u6267\u884C\u3002\n\u203B\u5956\u54C1\u4F1A\u6839\u636E\u63D0\u4F9B\u6BD4\u4F8B\u6BCF\u6B21\u8FDB\u884C\u62BD\u9009\u3002\u4F8B\u5982\uFF0C\u63D0\u4F9B\u6BD4\u4F8B\u4E3A1%\u7684\u9053\u5177\uFF0C\u5E76\u4E0D\u8868\u793A100\u6B21\u4E2D\u5FC5\u5B9A\u51FA\u73B01\u6B21\u3002\n\u203B\u901A\u8FC7\u5956\u54C1\u83B7\u5F97\u7684\u201C[4\u5468\u5E74\u7EAA\u5FF5]Bloom Festival\u626D\u86CB\u4E13\u7528\u7968\u5238\u201D\uFF0C\u662F\u4EC5\u53EF\u5728\u9884\u5B9A9\u670830\u65E512\u70B9\u4E3E\u529E\u7684\u201C[4\u5468\u5E74\u7EAA\u5FF5]Bloom Festival\u626D\u86CB Dream Pick\u201D\u4E2D\u4F7F\u7528\u7684\u626D\u86CB\u7968\u5238\u3002\u6B64\u5916\uFF0C\u82E5\u8D85\u8FC7\u4E3E\u529E\u671F\u9650\uFF0C\u201C[4\u5468\u5E74\u7EAA\u5FF5]Bloom Festival\u626D\u86CB\u4E13\u7528\u7968\u5238\u201D\u5C06\u65E0\u6CD5\u4F7F\u7528\uFF0C\u8BF7\u6CE8\u610F\u3002\n\u203B\u901A\u8FC7\u5956\u54C1\u83B7\u5F97\u7684\u201C[4\u5468\u5E74\u7EAA\u5FF5]10\u8FDE\u514D\u8D39\u626D\u86CB\u7968\u5238\u201D\uFF0C\u662F\u4EC5\u53EF\u5728\u9884\u5B9A9\u670830\u65E512\u70B9\u4E3E\u529E\u7684\u201C[4\u5468\u5E74\u7EAA\u5FF5]10\u8FDE\u514D\u8D39\u626D\u86CB\u201D\u4E2D\u4F7F\u7528\u7684\u626D\u86CB\u7968\u5238\u3002\u6B64\u5916\uFF0C\u82E5\u8D85\u8FC7\u4E3E\u529E\u671F\u9650\uFF0C\u201C[4\u5468\u5E74\u7EAA\u5FF5]10\u8FDE\u514D\u8D39\u626D\u86CB\u7968\u5238\u201D\u5C06\u65E0\u6CD5\u4F7F\u7528\uFF0C\u8BF7\u6CE8\u610F\u3002"
