    m_Localized: "\u70B9\u51FB\u53D1\u9001\u6309\u94AE\u540E\uFF0C\u90AE\u4EF6\u4F1A\u542F\u52A8\u3002\n\u90AE\u4EF6\u4E2D\u4F1A\u81EA\u52A8\u9644\u52A0\u540D\u4E3Alog.bin\u7684\u65E5\u5FD7\u6587\u4EF6\u3002\nlog.bin\u6587\u4EF6\u4F1A\u7528\u4E8E\u8C03\u67E5\u7B49\u7528\u9014\uFF0C\u8BF7\u4E0D\u8981\u5220\u9664\u5E76\u8FDB\u884C\u54A8\u8BE2\u3002"
