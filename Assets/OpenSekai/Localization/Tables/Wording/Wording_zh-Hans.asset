  - m_Id: 279962120
    m_Localized: "<color=#ff5599>\u6301\u7EED\u8D2D\u4E70Colorful Pass\u540E\u5373\u53EF\u62A5\u540D\u3002\n\u203B\u6309\u6709\u6548\u671F\u7ED3\u675F\u6B21\u65E5\u8D2D\u4E70\u7684\u60C5\u51B5\u8FDB\u884C\u8BA1\u7B97\u3002</color>"
