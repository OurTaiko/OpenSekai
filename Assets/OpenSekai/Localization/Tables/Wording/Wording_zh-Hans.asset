  - m_Id: 275767345
    m_Localized: "\u8DDD\u79BB\u4E0B\u6B21\u6062\u590D\u8FD8\u6709<color=#ff5599>{0}</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 275767346
    m_Localized: "\u672A\u627E\u5230\u5BF9\u624B\uFF0C\u5C06\u8FD4\u56DELIVE\u9996\u9875\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 275767347
    m_Localized: "\u672A\u627E\u5230\u5BF9\u624B\u3002\u8981\u8FD4\u56DE\u5339\u914D\u5417\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 275767348
    m_Localized: "\u56E0\u8FDE\u7EED\u68C0\u6D4B\u5230\u65AD\u7EBF\u884C\u4E3A\u6216\u8FDD\u89C4\u884C\u4E3A\uFF0C\n\u5C06\u6682\u65F6\u9650\u5236\u6392\u4F4D\u8D5B\u529F\u80FD\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 275767349
    m_Localized: "\u56E0\u8FDE\u7EED\u68C0\u6D4B\u5230\u65AD\u7EBF\u884C\u4E3A\u6216\u8FDD\u89C4\u884C\u4E3A\uFF0C\n\u5C06\u6682\u65F6\u9650\u5236\u6392\u4F4D\u8D5B\u529F\u80FD\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 275767350
    m_Localized: "\u672C\u8D5B\u5B63\u65E0\u6CD5\u53C2\u52A0\u6392\u4F4D\u8D5B"
    m_Metadata:
      m_Items: []
  - m_Id: 275767351
    m_Localized: "\u6392\u4F4D\u8D5B\u4E2D\u68C0\u6D4B\u5230\u65AD\u7EBF\u6216\u8FDD\u89C4\u884C\u4E3A\uFF0C\n\u672C\u6B21LIVE\u5C06\u6309\u5931\u8D25\u5904\u7406\u3002\n\n\u82E5\u53CD\u590D\u68C0\u6D4B\u5230\u65AD\u7EBF\u6216\u8FDD\u89C4\u884C\u4E3A\uFF0C\n\u53EF\u80FD\u4F1A\u65E0\u6CD5\u53C2\u52A0\u6392\u4F4D\u8D5B\uFF0C\u6216\u88AB\u505C\u6B62\u4F7F\u7528\u6570\u636E\n\u7684\u53EF\u80FD\u6027\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 275767352
    m_Localized: "\u7531AI\u63D0\u4F9B\u7684\u804A\u5929\u5BA2\u670D\u4F1A\u7ACB\u5373\u56DE\u7B54\u3002\n\u5173\u4E8E\u6E38\u620F\u8FD0\u884C\u3001\u8FDB\u5EA6\u6216\u6545\u969C\u7684\u95EE\u9898\uFF0C\u63A8\u8350\u4F7F\u7528\u8FD9\u91CC\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 275767353
    m_Localized: "FAQ\u4E2D\u53EF\u67E5\u770B\u73A9\u5BB6\u7ECF\u5E38\u63D0\u51FA\u7684\u95EE\u9898\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 275767354
    m_Localized: "\u5173\u4E8ELIVE P\u7684\u83B7\u53D6"
    m_Metadata:
      m_Items: []
  - m_Id: 275767355
    m_Localized: "\u6BCF\u5929\u6700\u591A1\u6B21\uFF0C\u5B8C\u6210\u89C2\u770B\u201CLIVE P&\u601D\u5FF5\u788E\u7247\u793C\u7269\u201D\u7684\u5E7F\u544A\u540E\uFF0C\u53EF<color=#ff5599>\u83B7\u5F9730\u70B9LIVE P</color>\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 275767356
    m_Localized: "\u89C2\u770B\u5E7F\u544A"
    m_Metadata:
      m_Items: []
  - m_Id: 275767357
    m_Localized: "\u6D3B\u52A8\u671F\u95F4\u6BCF\u5B8C\u62101\u4E2A\u4E3E\u529E\u4E2D\u7684\u5956\u52B1\u4EFB\u52A1\uFF0C\u53EF<color=#ff5599>\u83B7\u5F9750\u70B9LIVE P</color>\u3002\n\u6B64\u5916\uFF0C\u5B8C\u6210\u5168\u90E8\u4EFB\u52A1\u540E\u53EF\u4ECE\u53EF\u9009\u5956\u52B1\u4E2D\u518D<color=#ff5599>\u83B7\u5F97150\u70B9LIVE P</color>\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 275767358
    m_Localized: "\u5956\u52B1\u4EFB\u52A1"
    m_Metadata:
      m_Items: []
  - m_Id: 275767359
    m_Localized: "\u6BCF\u901A\u51731\u6B21\u53EF<color=#ff5599>\u83B7\u5F9730\u70B9LIVE P</color>\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 275767360
    m_Localized: Challenge LIVE
    m_Metadata:
      m_Items: []
  - m_Id: 275767361
    m_Localized: "\u6BCF\u901A\u51731\u6B21\u53EF<color=#ff5599>\u83B7\u5F971\u70B9LIVE P</color>\u3002\n\u203B\u901A\u8FC7\u6D88\u8017LIVE BONUS\u53EF\u589E\u52A0\u83B7\u5F97\u91CF\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 275767362
    m_Localized: "\u5355\u4EBALIVE/\u591A\u4EBALIVE/Cheerful LIVE/\u6392\u4F4D\u8D5B"
    m_Metadata:
      m_Items: []
  - m_Id: 275767363
    m_Localized: "\u6BCF\u5929\u6700\u591A3\u6B21\uFF0C\u6BCF\u901A\u51731\u6B21\u201C\u591A\u4EBALIVE\u30FBCheerful LIVE\u201D\n\u5373\u53EF<color=#ff5599>\u83B7\u5F9710\u70B9LIVE P</color>\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 275767364
    m_Localized: "\u6BCF\u65E5\u5956\u52B1"
    m_Metadata:
      m_Items: []
  - m_Id: 275767365
    m_Localized: "\u666E\u901A\u4F53\u529B\u65F6\uFF0C\u6BCF\u6D88\u80171\u683C\u4F53\u529B\u53EF<color=#ff55AA>\u83B7\u5F971\u70B9LIVE P</color>\u3002\n\u52A0\u6210\u4F53\u529B\u65F6\uFF0C\u6BCF\u6D88\u80171\u683C\u4F53\u529B\u53EF<color=#ff55AA>\u83B7\u5F975\u70B9LIVE P</color>\u3002\n\u203B\u53EF\u80FD\u4F1A\u4EA7\u751F\u5C0F\u6570\u70B9\u4EE5\u4E0B\u7684LIVE P\u3002\n\u203B\u5C0F\u6570\u70B9\u4EE5\u4E0B\u7684LIVE P\u6BCF\u7D2F\u8BA1\u52301\u70B9\uFF0C\u5C31\u4F1A\u52A0\u5165\u7D2F\u8BA1LIVE P\u3002\n\u203B\u5C0F\u6570\u70B9\u4EE5\u4E0B\u7684LIVE P\u4F1A\u5728\u6BCF\u67080:00\u6E05\u96F6\uFF0C\u8BF7\u6CE8\u610F\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 275767366
    m_Localized: "My SEKAI \u91C7\u96C6"
    m_Metadata:
      m_Items: []
  - m_Id: 275767367
    m_Localized: "\u8BF7\u4ECE\u4E0B\u65B9\u6309\u94AE\u4E2D\u9009\u62E9\u5BF9\u5E94\u95EE\u9898\u3002\n\u6211\u4EEC\u5C06\u901A\u8FC7\u90AE\u4EF6\u53D7\u7406\u54A8\u8BE2\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 275767368
    m_Localized: "\u8FD9\u662F\u53EF\u901A\u8FC7\u201C[{0}]{1}\u201D\u89E3\u9501\u7684\n\u53D1\u578B\u4E13\u7528\u9970\u54C1\uFF0C\n\u89E3\u9501\u8BE5\u53D1\u578B\u540E\u5373\u53EF\u8BBE\u7F6E\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 275767369
    m_Localized: "\u70B9\u51FB\u8C03\u6574"
    m_Metadata:
      m_Items: []
  - m_Id: 275767370
    m_Localized: "\u53EF\u4EE5\u8C03\u6574\u5224\u5B9A\u65F6\u673A\u3002\n\u8BF7\u914D\u5408\u9AD8\u97F3\u54CD\u8D77\u7684\u65F6\u673A\n\u70B9\u51FB\u4E0B\u65B9\u6309\u94AE\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 275767371
    m_Localized: "\u8981\u4F7F\u7528\u81EA\u52A8\u8C03\u6574\u7ED3\u679C\u8FDB\u884C\u8BBE\u7F6E\u5417\uFF1F"
