  - m_Id: 279962126
    m_Localized: "\u6CA1\u6709\u53EF\u62A5\u540D\u7684\u6D3B\u52A8\u3002\n\u5C06\u8FD4\u56DE\u4E3B\u9875\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 279962127
    m_Localized: "{0} \uFF5E\n{1}\n<color=#ff5588>\u203B\u9700\u8981\u5728\u6B64\u671F\u95F4\u6EE1\u8DB3</color>\n<color=#ff5588>\u6240\u9700\u8FDE\u7EED\u671F\u95F4\u3002</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 279962128
    m_Localized: "\u25A0\u6709\u6548\u671F\n\n{0}\n\n\u25A0\u5957\u88C5\u5185\u5BB9\n\n\u30FB\u6C34\u6676(\u4ED8\u8D39)\xD7440\u4E2A\n\u30FB14\u5929\u6C34\u6676(\u514D\u8D39)\xD750\u4E2A(\u5956\u52B1)\n\u30FB\u53EF\u62BD\u53D6\u201C\u6BCF\u65E51\u6B21\u4ED8\u8D39\u626D\u86CB\u201D2\u6B21(\u5956\u52B1)\n\u30FBChallenge P\u83B7\u5F97\u91CF2\u500D(\u5956\u52B1)\n\u30FBLIVE P\u83B7\u5F97\u91CF2\u500D(\u5956\u52B1)\n\u203B\u9664\u201C\u6C34\u6676(\u4ED8\u8D39)\xD7440\u4E2A\u201D\u4EE5\u5916\u7684\u5956\u52B1\uFF0C\u5747\u4E3A\u8D2D\u4E70\u540E30\u5929\u5185\u6709\u6548\u7684\u7279\u5178\u3002\n\n\n\u25A0\u7D2F\u8BA1\u8D2D\u4E70\u6B21\u6570\u7279\u5178\n\n\u30FB\u4F1A\u6839\u636EColorful Pass\u7684\u8D2D\u4E70\u6B21\u6570\u9644\u5E26\u7279\u5178\u3002\n\n[\u7B2C1\u6B21]\u6C34\u6676(\u514D\u8D39)\xD7100\u4E2A\n[\u7B2C2\u6B21]\u6C34\u6676(\u514D\u8D39)\xD7200\u4E2A\n[\u7B2C3\u6B21]\u6C34\u6676(\u514D\u8D39)\xD7300\u4E2A\n[\u7B2C4\u6B21]\u6C34\u6676(\u514D\u8D39)\xD7500\u4E2A\n[\u7B2C5\u6B21]\u6C34\u6676(\u514D\u8D39)\xD7700\u4E2A\n[\u7B2C6\u6B21]\u6C34\u6676(\u514D\u8D39)\xD71000\u4E2A\n\u203B\u7B2C7\u6B21\u8D2D\u4E70\u4EE5\u540E\u5C06\u56DE\u5230\u7B2C1\u6B21\u3002\n\n\n\u25A0\u5546\u54C1\u6B3E\u9879\u7684\u652F\u4ED8\u65F6\u95F4\n\n\u30FB\u4FE1\u7528\u5361\uFF1A\u4EE5\u5404\u4FE1\u7528\u5361\u516C\u53F8\u6263\u6B3E\u65E5\u4E3A\u51C6\u3002\n\u30FB\u624B\u673A\u8FD0\u8425\u5546\u5408\u5E76\u8BA1\u8D39\uFF1A\u5C06\u4E0E\u624B\u673A\u8BDD\u8D39\u4E00\u540C\u8BF7\u6C42\u652F\u4ED8\u3002\u652F\u4ED8\u65F6\u95F4\u4F9D\u624B\u673A\u8FD0\u8425\u5546\u89C4\u5B9A\u800C\u5B9A\u3002\n\u30FB\u672C\u516C\u53F8\u53D1\u884C\u7684\u9884\u4ED8\u5F0F\u652F\u4ED8\u624B\u6BB5\uFF1A\u4EE5\u5BA2\u6237\u5728\u6700\u7EC8\u786E\u8BA4\u753B\u9762\u70B9\u51FB\u786E\u5B9A\u8D2D\u4E70\u6309\u94AE\u65F6\u4E3A\u652F\u4ED8\u65F6\u95F4\u3002\n\u30FB\u5176\u4ED6\u7531\u4EE3\u529E\u8D2D\u4E70\u76F8\u5173\u7ED3\u7B97\u7684\u516C\u53F8\u63D0\u4F9B\u7684\u652F\u4ED8\u65B9\u5F0F\uFF1A\u652F\u4ED8\u65B9\u5F0F\u4F1A\u6839\u636E\u6240\u4F7F\u7528\u7684\u7ED3\u7B97\u4EE3\u529E\u516C\u53F8\u800C\u4E0D\u540C\u3002\u652F\u4ED8\u65F6\u95F4\u4F9D\u6240\u4F7F\u7528\u7ED3\u7B97\u4EE3\u529E\u516C\u53F8\u7684\u89C4\u5B9A\u800C\u5B9A\u3002\n\n\n\u25A0\u5546\u54C1\u4EA4\u4ED8\u65F6\u95F4\n\u30FB\u6C34\u6676(\u4ED8\u8D39)\uFF1A\u8D2D\u4E70\u5B8C\u6210\u540E\u7ACB\u5373\u4EA4\u4ED8\u3002\n\u30FB\u7D2F\u8BA1\u8D2D\u4E70\u6B21\u6570\u7279\u5178\uFF1A\u8D2D\u4E70\u5B8C\u6210\u540E\u7ACB\u5373\u4EA4\u4ED8\u3002\n\u30FB14\u5929\u6C34\u6676(\u514D\u8D39)\uFF1A\u8D2D\u4E70\u624B\u7EED\u5B8C\u6210\u540E30\u5929\u5185\u6700\u591A14\u6B21\uFF0C\u6BCF\u59291\u6B21\u767B\u5F55\u65F6\u901A\u8FC7\u793C\u7269\u4EA4\u4ED8\u3002\n\u30FB\u53EF\u62BD\u53D6\u201C\u6BCF\u65E51\u6B21\u4ED8\u8D39\u626D\u86CB\u201D2\u6B21(\u5956\u52B1)\uFF1A\u8D2D\u4E70\u5B8C\u6210\u540E\u7ACB\u5373\u4EA4\u4ED8\u3002\n\u30FBChallenge P\u83B7\u5F97\u91CF2\u500D\uFF1A\u8D2D\u4E70\u5B8C\u6210\u540E\u7ACB\u5373\u4EA4\u4ED8\u3002\n\u30FBLIVE P\u83B7\u5F97\u91CF2\u500D\uFF1A\u8D2D\u4E70\u5B8C\u6210\u540E\u7ACB\u5373\u4EA4\u4ED8\u3002\n\u203B\u6C34\u6676\u5C5E\u4E8E\u9884\u4ED8\u5F0F\u652F\u4ED8\u624B\u6BB5\u3002\n\u203B\u9009\u62E9\u201C\u4FBF\u5229\u5E97\u652F\u4ED8\u201D\u65F6\uFF0C\u56E0\u7CFB\u7EDF\u539F\u56E0\uFF0C\u5546\u54C1\u4EA4\u4ED8\u53EF\u80FD\u9700\u8981\u6570\u5C0F\u65F6\u81F3\u6570\u65E5\uFF0C\u65E0\u6CD5\u7ACB\u5373\u4EA4\u4ED8\uFF0C\u8BF7\u6CE8\u610F\u3002\n\n\n\u25A0\u5546\u54C1\u7684\u9000\u8D27\u30FB\u4EA4\u6362\n\u56E0\u5546\u54C1\u6027\u8D28\u6240\u9650\uFF0C\u4E0D\u63A5\u53D7\u4EFB\u4F55\u9000\u8D27\u6216\u4EA4\u6362\u3002\n\n\n\u25A0\u6CE8\u610F\u4E8B\u9879\n\u30FB\u8D2D\u4E70\u540E30\u5929\u7279\u5178\u81EA\u8D2D\u4E70\u201CColorful Pass\u201D\u4E4B\u65E5\u8D7730\u5929\u5185\u751F\u6548\u3002\n\u30FB\u201C14\u5929\u6C34\u6676(\u514D\u8D39)\xD750\u4E2A\u201D\u53EF\u4ECE\u8D2D\u4E70\u5F53\u65E5\u8D77\uFF0C\u6BCF\u5929\u767B\u5F55\u6E38\u620F1\u6B21\u65F6\u9886\u53D6\u3002\n\u30FB\u201C14\u5929\u6C34\u6676(\u514D\u8D39)\xD750\u4E2A\u201D\u6700\u591A\u53EF\u9886\u53D614\u6B21\u3002\n\u30FB\u83B7\u5F97\u201C14\u5929\u6C34\u6676(\u514D\u8D39)\xD750\u4E2A\u201D\u7684\u673A\u4F1A\u4F1A\u5728\u6BCF\u59294\u70B9\u91CD\u7F6E\u3002\n\u30FB\u5957\u88C5\u5185\u5BB9\u4E2D\u7684\u300E\u53EF\u62BD\u53D6\u201C\u6BCF\u65E51\u6B21\u4ED8\u8D39\u626D\u86CB\u201D2\u6B21(\u5956\u52B1)\u300F\u5728\u672A\u4E3E\u529E\u201C\u6BCF\u65E51\u6B21\u4ED8\u8D39\u626D\u86CB\u201D\u7684\u671F\u95F4\u5185\u4E0D\u4F1A\u9002\u7528\u3002\u656C\u8BF7\u8C05\u89E3\u3002\n\u30FB\u201CLIVE P\u83B7\u5F97\u91CF2\u500D\u201D\u4E0D\u4EC5\u9002\u7528\u4E8E\u901A\u8FC7LIVE\u83B7\u5F97\u7684LIVE P\uFF0C\u4E5F\u9002\u7528\u4E8E\u6BCF\u65E5\u5956\u52B1\u3001\u5956\u52B1\u4EFB\u52A1\u62A5\u916C\u53EF\u83B7\u5F97\u7684LIVE P\u3002\n\u30FB\u8D2D\u4E70\u201CColorful Pass\u201D\u540E\u7ECF\u8FC730\u5929\uFF0C\u5373\u4F7F\u8D2D\u4E70\u540E30\u5929\u7279\u5178\u5C1A\u672A\u5168\u90E8\u9886\u53D6\u4E5F\u4F1A\u5931\u6548\uFF0C\u8BF7\u6CE8\u610F\u3002\n\u30FB\u201CColorful Pass\u201D\u7ECF\u8FC730\u5929\u540E\u53EF\u518D\u6B21\u8D2D\u4E70\u3002\n\u30FB\u5373\u4F7F\u8FDB\u884C\u540COS\u8BBE\u5907\u66F4\u6362\u6216\u8DE8OS\u6570\u636E\u7EE7\u627F\uFF0C\u5305\u542B\u201CColorful Pass\u201D\u8D2D\u4E70\u6B21\u6570\u5728\u5185\u7684\u8D2D\u4E70\u4FE1\u606F\u4E5F\u4F1A\u7EE7\u627F\uFF0C\u53EF\u7EE7\u7EED\u9886\u53D6\u7279\u5178\u3002"
